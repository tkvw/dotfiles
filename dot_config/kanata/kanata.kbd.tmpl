#|
================================================================================
  KANATA CONFIG — Neovim Developer (Windows)
================================================================================

  Key ideas:
  1. CapsLock → Escape (tap only, no hold layer)
  2. Home Row Modifiers: A=Sym, S=Alt, D=Ctrl, F=Shift | J=Shift, K=Ctrl, L=Alt, ;=Sym-extra
  3. Space → Space (tap) / Navigation layer (hold)
  4. A → a (tap) / Symbols layer (hold) — right hand types symbols
  5. ; → ; (tap) / Symbol extra layer (hold) — left hand types remaining symbols
  6. X → x (tap) / Mouse fast layer (hold) — large cursor jumps
  7. C → c (tap) / Mouse slow layer (hold) — precise cursor movement
  8. ralt → Backspace (tap) / Function keys layer (hold)
  9. lctl → lmet (Windows key for shortcuts)

  Combos (simultaneous key presses):
    a+s = Tab    s+d = Esc    j+k = Backspace   k+l = Delete
    f+d = Enter  e+r = -      f+j = Caps Word

  Symbol layers overview (hold A, type right hand):

  sym (hold A):              sym-extra (hold ;):
        ^  [  ]  &                 !  &  #  $
        (  {  }  )  _           ~  %  -  +  =
        `  <  >

  Nav layer (hold Space):
        right hand: mlft ←mouse ↓mouse ↑mouse →mouse mrgt
                    ←    ↓      ↑      →
                    home pgdn   pgup   end

  Mouse layers (hold X = fast, hold C = slow):
        y=lclick  u=scrolldn  i=scrollup  o=rclick
        h=left    j=down      k=up        l=right
        m=midclick

  Function keys layer (hold ralt/Backspace):
        F1-F5   | F6-F10 F11
        1-5     | 6-9 0  F12
        mute vold volu play

================================================================================
|#

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defvar
  tt 200   ;; tap timeout (ms)
  ht 200   ;; hold timeout (ms)
)

;; ---------------------------------------------------------------------------
;; Symbol aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; Parentheses and brackets
  lpr S-9    ;; ( left parenthesis
  rpr S-0    ;; ) right parenthesis
  lbr S-[    ;; { left brace
  rbr S-]    ;; } right brace
  lbk [      ;; [ left bracket
  rbk ]      ;; ] right bracket
  les S-,    ;; < less than
  grt S-.    ;; > greater than

  ;; Arithmetic and comparison
  pls S-=    ;; + plus
  min -      ;; - minus / hyphen
  ast S-8    ;; * asterisk
  fsl /      ;; / forward slash
  bsl \      ;; \ backslash
  eql =      ;; = equals
  crt S-6    ;; ^ caret

  ;; Punctuation
  exc S-1    ;; ! exclamation mark
  ats S-2    ;; @ at sign
  hsh S-3    ;; # hash
  dlr S-4    ;; $ dollar sign
  pct S-5    ;; % percent
  amp S-7    ;; & ampersand
  pip S-\    ;; | pipe
  tld S-grv  ;; ~ tilde
  btk grv    ;; ` backtick
  usc S--    ;; _ underscore
  cln S-;    ;; : colon
  qmk S-/    ;; ? question mark
  dqt S-'    ;; " double quote
  scl ;      ;; ; semicolon
)

;; ---------------------------------------------------------------------------
;; Mouse aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; Fast mouse — accelerated movement for large jumps
  ;; movemouse-accel: interval(ms)  accel-time(ms)  min-dist(px)  max-dist(px)
  mfu (movemouse-accel-up    1 1000 1 20)
  mfd (movemouse-accel-down  1 1000 1 20)
  mfl (movemouse-accel-left  1 1000 1 20)
  mfr (movemouse-accel-right 1 1000 1 20)

  ;; Slow mouse — precise 1px movement
  ;; movemouse: interval(ms)  distance(px)
  msu (movemouse-up    50 1)
  msd (movemouse-down  50 1)
  msl (movemouse-left  50 1)
  msr (movemouse-right 50 1)

  ;; Scroll
  mwu (mwheel-up   50 120)
  mwd (mwheel-down 50 120)
)

;; ---------------------------------------------------------------------------
;; Behaviour aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; A → a (tap) / Symbols layer (hold)
  a-mod (tap-hold-release $tt $ht a (layer-toggle sym))

  ;; Home Row Modifiers (GACS: Sym-Alt-Ctrl-Shift)
  s-mod (tap-hold-release $tt $ht s lalt)
  d-mod (tap-hold-release $tt $ht d lctl)
  f-mod (tap-hold-release $tt $ht f lsft)
  j-mod (tap-hold-release $tt $ht j rsft)
  k-mod (tap-hold-release $tt $ht k rctl)
  l-mod (tap-hold-release $tt $ht l lalt)

  ;; ; → ; (tap) / Symbol extra layer (hold)
  ;-mod (tap-hold-release $tt $ht ; (layer-toggle sym-extra))

  ;; Space → Space (tap) / Navigation layer (hold)
  spc-mod (tap-hold-release $tt $ht spc (layer-toggle nav))

  ;; X → x (tap) / Mouse fast layer (hold)
  x-mod (tap-hold-release $tt $ht x (layer-toggle mouse-fast))

  ;; ralt position: Backspace (tap) / Function keys layer (hold)
  bspc-mod (tap-hold-release $tt $ht bspc (layer-toggle fn))

  ;; C → c (tap) / Mouse slow layer (hold)
  c-mod (tap-hold-release $tt $ht c (layer-toggle mouse-slow))

  ;; Caps Word — auto-uppercase until space/punctuation (2s timeout)
  cw (caps-word 2000)
)

;; ---------------------------------------------------------------------------
;; Physical key layout (standard ANSI QWERTY)
;; ---------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ---------------------------------------------------------------------------
;; Base layer
;; ---------------------------------------------------------------------------
;;  caps → esc | home row mods | lctl → lmet | ralt → bspc/fn
;;
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  esc  @a-mod @s-mod @d-mod @f-mod g h  @j-mod @k-mod @l-mod @;-mod ' ret
  lsft z    @x-mod @c-mod v    b    n    m    ,    .    /    rsft
  lmet lmet lalt           @spc-mod       @bspc-mod rmet rctl
)

(defchordsv2
  (a s)      tab       40 first-release ()
  (s d)      esc       40 first-release ()
  (j k)      bspc      40 first-release ()
  (k l)      del       40 first-release ()
  (f d)      ret       40 first-release ()
  (e r)      @min      40 first-release ()
  (f j)      @cw       40 first-release ()
)

;; ---------------------------------------------------------------------------
;; Navigation layer (hold Space)
;; ---------------------------------------------------------------------------
;;  row 2: mlft  ←mouse ↓mouse ↑mouse →mouse  mrgt
;;  row 3:       ←      ↓      ↑       →
;;  row 4:       home   pgdn   pgup    end
;;
(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    mlft @mfl @mfd @mfu @mfr mrgt _    _
  _    _    _    _    _    _    _    left down up   rght _    _
  _    _    _    _    _    _    _    home pgdn pgup end  _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Symbols layer (hold A)
;; ---------------------------------------------------------------------------
;;  row 2:  ^   [   ]   &
;;  row 3:  (   {   }   )   _
;;  row 4:  `   <   >
;;
(deflayer sym
  _    _    _    _    _      _    _    _    _    _    _    _    _    _
  _    _    _    _    _      _    @crt @lbk @rbk @amp _    _    _    _
  _    _    _    _    _      _    @lpr @lbr @rbr @rpr @usc _    _
  _    _    _    _    _      _    @btk @les @grt _    _    _
  _    _    _                _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Symbols extra layer (hold ;)
;; ---------------------------------------------------------------------------
;;  row 2:  !   &   #   $          (left hand)
;;  row 3:  ~   %   -   +   =     (left hand)
;;
(deflayer sym-extra
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    @exc @amp @hsh @dlr _    _    _    _    _    _    _    _    _
  @tld @pct @min @pls @eql _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Function keys layer (hold ralt/Backspace)
;; ---------------------------------------------------------------------------
;;  row 2:  F1  F2  F3  F4  F5  |  F6  F7  F8  F9  F10  F11
;;  row 3:  1   2   3   4   5   |  6   7   8   9   0    F12
;;  row 4:  mute vold volu play
;;
(deflayer fn
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    f1   f2   f3   f4   f5   f6   f7   f8   f9   f10  f11  _    _
  _    1    2    3    4    5    6    7    8    9    0    f12  _
  _    mute vold volu pp   _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Mouse fast layer (hold X) — accelerated movement
;; ---------------------------------------------------------------------------
;;  row 2:  lclick  scroll↓  scroll↑  rclick
;;  row 3:  ←       ↓        ↑        →
;;  row 4:          midclick
;;
(deflayer mouse-fast
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    mlft @mwd @mwu mrgt _    _    _    _
  _    _    _    _    _    _    @mfl @mfd @mfu @mfr _    _    _
  _    _    _    _    _    _    _    mmid _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Mouse slow layer (hold C) — 1px precise movement
;; ---------------------------------------------------------------------------
;;  row 2:  lclick  scroll↓  scroll↑  rclick
;;  row 3:  ←       ↓        ↑        →
;;  row 4:          midclick
;;
(deflayer mouse-slow
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    mlft @mwd @mwu mrgt _    _    _    _
  _    _    _    _    _    _    @msl @msd @msu @msr _    _    _
  _    _    _    _    _    _    _    mmid _    _    _    _
  _    _    _              _              _    _    _
)
