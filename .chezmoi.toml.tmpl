{{- $chezmoi_age_file := "~/.config/age/chezmoi.txt" -}}

encryption = "age"
[age]
    identity = "{{ $chezmoi_age_file }}"
    recipients = [
      "age139tak66akncp4xddr9snd6f6gqq6t056hkjcn604uvyklte28acsqcyncs",
      "age1uj4hw4smpe8h49yc8l3lkpxga0upx9a5380mky32uz5qlatcdyaq9xzqms"
    ]

[cd]
    command = "nu"

[interpreters.ps1]
  command = "pwsh"
  args = ["-NoProfile", "-ExecutionPolicy", "Bypass" ]

{{ $isWsl := and (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) -}}
{{ $isDocker := stat "/.dockerenv" | not | not -}}
[data]
  wsl = {{ $isWsl }}
  age = {{ stat $chezmoi_age_file | not | not }}
  docker = {{ $isDocker }}
