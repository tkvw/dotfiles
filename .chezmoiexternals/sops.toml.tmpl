{{ if .is_win }}

  [".local/bin/sops.exe"]
      type = "file"
      url = {{ gitHubLatestReleaseAssetURL "getsops/sops" (printf "sops-*.%s.exe" .chezmoi.arch) | quote }}
      executable = true

{{ else if .is_linux }}
  [".local/bin/sops"]
      type = "file"
      url = {{ gitHubLatestReleaseAssetURL "getsops/sops" (printf "sops-*.%s.%s" .chezmoi.os .chezmoi.arch) | quote }}
      executable = true

{{ end }}
