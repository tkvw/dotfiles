[core]
	excludesFile = {{ joinPath .chezmoi.homeDir ".gitignore" | quote }}
	autocrlf = input
	eol = lf

[user]
	name = {{ .git.name }}
	email = {{ .git.home.email }}
	signingkey = {{ joinPath .chezmoi.homeDir ".ssh" .git.home.signingkey | quote  }}

[init]
	defaultBranch = main
[safe]
	directory = *

[gpg]
	format = ssh

[commit]
	gpgsign = true

[includeIf "gitdir:~/src/github.com/asdennie/"]
  path = ~/.gitconfig-work
