#|
================================================================================
  KANATA CONFIG — Neovim Developer (Windows)
================================================================================

  Key ideas:
  1. CapsLock → Escape (tap) / Editing layer (hold)
     - h = Backspace, j = Delete, k = Enter
  2. Home Row Modifiers on S, D, F and J, K, L
  3. Space → Space (tap) / Navigation layer (hold)
  4. A → a (tap) / Symbols layer (hold) — right hand types symbols
  5. A + F → Symbol extra layer — remaining symbols on right hand
  6. ; → ; (tap) / Function keys layer (hold) — left hand types F-keys
  7. X → x (tap) / Mouse fast layer (hold) — large cursor jumps
  8. C → c (tap) / Mouse slow layer (hold) — precise cursor movement
  9. lctl (bottom left) becomes lmet for Windows shortcuts
  10. ralt becomes Backspace for easy reach

  Symbol layers overview (hold A, type right hand):

  sym:        ~  [  ]  $  &  #        sym-extra:     !  &  ^  $  ?
              (  {  }  )                              %  -  +  *  =  _
              `  <  >

  Mouse layers (hold X = fast, hold C = slow):

              y=lclick  u=scrolldn  i=scrollup  o=rclick
              h=left    j=down      k=up        l=right
              m=midclick

  Exit Kanata: hold Left Control + Space + Escape simultaneously

================================================================================
|#

(defcfg
  process-unmapped-keys yes
  concurrent-tap-hold yes
)

(defvar
  tt 150   ;; tap timeout (ms)
  ht 200   ;; hold timeout (ms)
)

;; ---------------------------------------------------------------------------
;; Symbol aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; Parentheses and brackets
  lpr S-9    ;; ( left parenthesis
  rpr S-0    ;; ) right parenthesis
  lbr S-[    ;; { left brace
  rbr S-]    ;; } right brace
  lbk [      ;; [ left bracket
  rbk ]      ;; ] right bracket
  les S-,    ;; < less than
  grt S-.    ;; > greater than

  ;; Arithmetic and comparison
  pls S-=    ;; + plus
  min -      ;; - minus / hyphen
  ast S-8    ;; * asterisk
  fsl /      ;; / forward slash
  bsl \      ;; \ backslash
  eql =      ;; = equals
  crt S-6    ;; ^ caret

  ;; Punctuation
  exc S-1    ;; ! exclamation mark
  ats S-2    ;; @ at sign
  hsh S-3    ;; # hash
  dlr S-4    ;; $ dollar sign
  pct S-5    ;; % percent
  amp S-7    ;; & ampersand
  pip S-\    ;; | pipe
  tld S-grv  ;; ~ tilde
  btk grv    ;; ` backtick
  usc S--    ;; _ underscore
  cln S-;    ;; : colon
  qmk S-/    ;; ? question mark
  dqt S-'    ;; " double quote
  scl ;      ;; ; semicolon
)

;; ---------------------------------------------------------------------------
;; Mouse aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; Fast mouse — large jumps across screen
  ;; movemouse-accel: interval(ms)  accel-time(ms)  min-dist(px)  max-dist(px)
  mfu (movemouse-accel-up    1 1000 1 20)
  mfd (movemouse-accel-down  1 1000 1 20)
  mfl (movemouse-accel-left  1 1000 1 20)
  mfr (movemouse-accel-right 1 1000 1 20)

  ;; Slow mouse — precise pixel movement
  ;; movemouse: interval(ms)  distance(px)
  msu (movemouse-up    50 1)
  msd (movemouse-down  50 1)
  msl (movemouse-left  50 1)
  msr (movemouse-right 50 1)

  ;; Scroll
  mwu (mwheel-up   50 120)
  mwd (mwheel-down 50 120)
)

;; ---------------------------------------------------------------------------
;; Behaviour aliases
;; ---------------------------------------------------------------------------
(defalias
  ;; === CapsLock → Escape (tap) / Editing layer (hold) ===
  ;; Tap for Esc (leave insert mode), hold for quick editing keys.
  ;; Ctrl is still available via D home row mod.
  ec (tap-hold-release $tt $ht esc (layer-toggle edit))

  ;; === A → a (tap) / Symbols layer (hold) ===
  a-mod (tap-hold-release $tt $ht a (layer-toggle sym))

  ;; === F on sym layer → activates sym-extra layer ===
  f-ext (layer-toggle sym-extra)

  ;; === Home Row Modifiers ===
  s-mod (tap-hold-release $tt $ht s lalt)
  d-mod (tap-hold-release $tt $ht d lctl)
  f-mod (tap-hold-release $tt $ht f lsft)
  j-mod (tap-hold-release $tt $ht j rsft)
  k-mod (tap-hold-release $tt $ht k rctl)
  l-mod (tap-hold-release $tt $ht l lalt)

  ;; === ; → ; (tap) / Function keys layer (hold) ===
  ;-mod (tap-hold-release $tt $ht ; (layer-toggle fn))

  ;; === Space → Space (tap) / Navigation layer (hold) ===
  spc-mod (tap-hold-release $tt $ht spc (layer-toggle nav))

  ;; === X → x (tap) / Mouse fast layer (hold) ===
  ;; Large jumps for quickly moving across the screen
  x-mod (tap-hold-release $tt $ht x (layer-toggle mouse-fast))

  ;; === C → c (tap) / Mouse slow layer (hold) ===
  ;; Small precise movements for clicking targets
  c-mod (tap-hold-release $tt $ht c (layer-toggle mouse-slow))
)

;; ---------------------------------------------------------------------------
;; Physical key layout (standard ANSI QWERTY)
;; ---------------------------------------------------------------------------
(defsrc
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

;; ---------------------------------------------------------------------------
;; Base layer
;; ---------------------------------------------------------------------------
(deflayer base
  grv  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  @ec  @a-mod @s-mod @d-mod @f-mod g h  @j-mod @k-mod @l-mod @;-mod ' ret
  lsft z    @x-mod @c-mod v    b    n    m    ,    .    /    rsft
  lmet lmet lalt           @spc-mod       bspc rmet rctl
)

;; ---------------------------------------------------------------------------
;; Editing layer (hold CapsLock)
;; ---------------------------------------------------------------------------
;; Quick access to Backspace, Delete, and Enter without leaving home row.
;;
;;        h      j      k
;;        bspc   del    ret
;;
(deflayer edit
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    bspc del  ret  _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Navigation layer (hold Space)
;; ---------------------------------------------------------------------------
;; Right hand: Vim-style movement
;; Left hand: common edit actions
;;
;;        y      u      i      o
;;        home   pgdn   pgup   end
;;
;;        h      j      k      l
;;        left   down   up     right
;;
(deflayer nav
  _    _    _    _    _    _    _    _    _    _    _    _    _    del
  _    _    _    _    _    _    home pgdn pgup end  _    _    _    _
  _    _    _    _    _    _    left down up   rght _    _    _
  _    C-z  C-x  C-c  C-v  _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Symbols layer (hold A)
;; ---------------------------------------------------------------------------
;; Primary developer symbols on the right hand.
;; Hold F to access sym-extra for the remaining symbols.
;;
;;        y      u      i      o      p      [
;;        ~      [      ]      $      &      #
;;
;;        h      j      k      l
;;        (      {      }      )
;;
;;        n      m      ,
;;        `      <      >
;;
(deflayer sym
  _    _    _    _    _      _    _    _    _    _    _    _    _    _
  _    _    _    _    _      _    @tld @lbk @rbk @dlr @amp @hsh _    _
  _    _    _    _    @f-ext _    @lpr @lbr @rbr @rpr _    _    _
  _    _    _    _    _      _    @btk @les @grt _    _    _
  _    _    _                _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Symbols extra layer (hold A + hold F)
;; ---------------------------------------------------------------------------
;; Remaining symbols for developers.
;;
;;        y      u      i      o      p      [
;;               !      &      ^      $      ?
;;
;;        h      j      k      l      ;      '
;;        %      -      +      *      =      _
;;
(deflayer sym-extra
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    @exc @amp @crt @dlr @qmk _    _
  _    _    _    _    _    _    @pct @min @pls @ast @eql @usc _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Function keys layer (hold ;)
;; ---------------------------------------------------------------------------
;; Left hand types F-keys while right hand holds ;.
;; G = live reload config.
;;
;;        1    2    3    4    5    6
;;        F1   F2   F3   F4   F5   F6
;;
;;        q    w    e    r    t
;;        F7   F8   F9   F10  F11  F12
;;
;;        z    x    c    v
;;        mute vold volu play/pause
;;
;;        g = live reload
;;
(deflayer fn
  _    f1   f2   f3   f4   f5   f6   _    _    _    _    _    _    _
  _    f7   f8   f9   f10  f11  f12  _    _    _    _    _    _    _
  _    _    _    _    _    lrld _    _    _    _    _    _    _
  _    mute vold volu pp   _    _    _    _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Mouse fast layer (hold X)
;; ---------------------------------------------------------------------------
;; Large cursor jumps for navigating across the screen.
;;
;;        y       u       i       o
;;        left    scroll  scroll  right
;;        click   down    up      click
;;
;;        h       j       k       l
;;        left    down    up      right
;;
;;        m
;;        middle click
;;
(deflayer mouse-fast
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    mlft @mwd @mwu mrgt _    _    _    _
  _    _    _    _    _    _    @mfl @mfd @mfu @mfr _    _    _
  _    _    _    _    _    _    _    mmid _    _    _    _
  _    _    _              _              _    _    _
)

;; ---------------------------------------------------------------------------
;; Mouse slow layer (hold C)
;; ---------------------------------------------------------------------------
;; Small precise cursor movements for accurate clicking.
;; Same layout as mouse-fast but with pixel-level precision.
;;
;;        y       u       i       o
;;        left    scroll  scroll  right
;;        click   down    up      click
;;
;;        h       j       k       l
;;        left    down    up      right
;;
;;        m
;;        middle click
;;
(deflayer mouse-slow
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    mlft @mwd @mwu mrgt _    _    _    _
  _    _    _    _    _    _    @msl @msd @msu @msr _    _    _
  _    _    _    _    _    _    _    mmid _    _    _    _
  _    _    _              _              _    _    _
)
