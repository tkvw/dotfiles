{{- if .is_wsl -}}
const NPIPERELAY = {{ printf "%s/.local/share/mise/installs/github-jstarks-npiperelay/0.1.0/npiperelay.exe" (includeTemplate "get_windows_home_dir_from_wsl" . | trim) | quote }}

$env.SSH_AUTH_SOCK = ($env.HOME | path join ".ssh" "agent.sock")

if (which socat | is-not-empty) and ($NPIPERELAY | path exists) {
    let sock = $env.SSH_AUTH_SOCK
    let running = (do { ps | where name =~ "socat" | where command =~ "agent.sock" } | is-not-empty)
    if not ($sock | path exists) or not $running {
        rm -f $sock
        ^setsid socat $"UNIX-LISTEN:($sock),fork" $"EXEC:($NPIPERELAY) -ei -s //./pipe/openssh-ssh-agent,nofork" out+err> /dev/null &
    }
}
{{- end }}
